+// identity is retained away from the finite-domain guard boundary.
+void damping_boundary(const vector_field<Scalar>& En,
+ const vector_field<Scalar>& Bn,const vector_field<Scalar>& Bbg,
+ vector_field<Scalar>& E,vector_field<Scalar>& B,
+ multi_array<Scalar>& Pn,multi_array<Scalar>& P,int shift,
+ const Grid& g,const sim_params& p) {
+ const Scalar xl[3]={p.lower[0]+p.pml[0]*g.delta[0],p.lower[1]+p.pml[1]*g.delta[1],p.lower[2]+p.pml[2]*g.delta[2]};
+ const Scalar xh[3]={p.lower[0]+p.size[0]-p.pml[0]*g.delta[0],p.lower[1]+p.size[1]-p.pml[1]*g.delta[1],p.lower[2]+p.size[2]-p.pml[2]*g.delta[2]};
+ for(int k=g.guard[2]-shift;k<g.dims[2]-g.guard[2]+shift;++k)
+ for(int j=g.guard[1]-shift;j<g.dims[1]-g.guard[1]+shift;++j)
+ for(int i=g.guard[0]-shift;i<g.dims[0]-g.guard[0]+shift;++i) {
+   const Scalar x[3]={g.pos(0,i,1),g.pos(1,j,1),g.pos(2,k,1)};
+   Scalar s[3]={0,0,0},n[3]={0,0,0},sig=0,nm=0;
+   for(int a=0;a<3;++a) if(p.pml[a]>0) {
+     s[a]=pmlsigma(x[a],xl[a],xh[a],p.pmllen*g.delta[a],p.sigpml);
+     sig+=s[a]; n[a]=(x[a]>xh[a]?1:-1)*s[a]; nm+=n[a]*n[a];
+   }
+   if(sig<TINY)continue;
+   nm=std::sqrt(nm);for(int a=0;a<3;++a)n[a]/=nm;
+   Scalar b[3],e[3],en=0;
+   for(int a=0;a<3;++a){b[a]=B(a,i,j,k)-Bbg(a,i,j,k);e[a]=E(a,i,j,k);en+=e[a]*n[a];}
+   const Scalar target[3]={-n[1]*b[2]+n[2]*b[1]+en*n[0],
+      -n[2]*b[0]+n[0]*b[2]+en*n[1],-n[0]*b[1]+n[1]*b[0]+en*n[2]};
+   for(int a=0;a<3;++a)E(a,i,j,k)=target[a]+std::exp(-sig)*(e[a]-target[a]);
