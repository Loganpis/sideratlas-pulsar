@@ -0,0 +1,35 @@
+// Verification driver only, GPL-2.0. Calls the unchanged COFFEE CPU EZ solver.
+#include "algorithms/field_solver_EZ.h"
+#include "data/sim_data.h"
+#include "sim_env.h"
+#include "utils/data_exporter.h"
+#include <cmath>
+using namespace Coffee;
+int main(int argc,char** argv) {
+  sim_environment env(&argc,&argv);
+  sim_data data(env);
+  field_solver_EZ solver(data,env);
+  Stagger collocated[3]={Stagger(0b111),Stagger(0b111),Stagger(0b111)};
+  data.E.set_stagger(collocated); data.B.set_stagger(collocated);
+  data.B0.set_stagger(collocated);
+  auto wave=[&](Scalar x,Scalar y,Scalar z) {
+    if(env.params().problem==3) return 0.2*std::exp(-std::pow((x+1.5)/.35,2));
+    return 0.2*std::sin(2*M_PI*x/env.params().size[0]);
+  };
+  data.E.initialize(); data.B.initialize(); data.B0.initialize();
+  data.E.initialize(1,wave);data.B.initialize(2,wave);
+  data.B.initialize(0,[](Scalar,Scalar,Scalar){return 1.0;});
+  solver.Bbg.initialize();
+  solver.Bbg.initialize(0,[](Scalar,Scalar,Scalar){return 1.0;});
+  data.P.assign(0.0); data.divB.assign(0.0);data.divE.assign(0.0);
+  data.dU_EgtB_cum.assign(0.0);data.dU_Epar_cum.assign(0.0);data.dU_KO_cum.assign(0.0);
+  env.send_guard_cells(data);
+  uint32_t step=0;data_exporter exporter(env,step);
+  for(;step<=env.params().max_steps;++step) {
+    Scalar time=step*env.params().dt;
+    if(step%env.params().data_interval==0)exporter.write_output(data,step,time);
+    if(step==env.params().max_steps)break;
+    solver.evolve_fields(time);
+  }
+  return 0;
+}
