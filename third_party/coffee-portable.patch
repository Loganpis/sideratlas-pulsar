+++ b/src/utils/scalar_lane.h
@@ -0,0 +1,26 @@
+// Project portability shim, 2026-10-14. Same GPL-2.0 as COFFEE.
+// One lane reproduces the VectorClass API used by the upstream CPU solver.
+// No field equation, finite difference, RK coefficient, or boundary is changed.
+struct ScalarLane {
+  Scalar value = 0;
+  ScalarLane() = default;
+  ScalarLane(Scalar x) : value(x) {}
+  void load(const Scalar* p) { value = *p; }
+  void store(Scalar* p) const { *p = value; }
+  ScalarLane& operator+=(ScalarLane x) { value += x.value; return *this; }
+  ScalarLane& operator-=(ScalarLane x) { value -= x.value; return *this; }
+  ScalarLane& operator*=(ScalarLane x) { value *= x.value; return *this; }
+  ScalarLane& operator/=(ScalarLane x) { value /= x.value; return *this; }
+  friend ScalarLane operator+(ScalarLane a, ScalarLane b) { return a.value+b.value; }
+  friend ScalarLane operator-(ScalarLane a, ScalarLane b) { return a.value-b.value; }
+  friend ScalarLane operator*(ScalarLane a, ScalarLane b) { return a.value*b.value; }
+  friend ScalarLane operator/(ScalarLane a, ScalarLane b) { return a.value/b.value; }
+  friend ScalarLane operator-(ScalarLane a) { return -a.value; }
+  friend bool operator>(ScalarLane a, ScalarLane b) { return a.value>b.value; }
+  friend bool operator<(ScalarLane a, ScalarLane b) { return a.value<b.value; }
+};
+inline ScalarLane sqrt(ScalarLane a) { return std::sqrt(a.value); }
+inline ScalarLane tanh(ScalarLane a) { return std::tanh(a.value); }
+inline ScalarLane max(ScalarLane a, ScalarLane b) { return a.value>b.value ? a:b; }
+inline ScalarLane select(bool cond, ScalarLane a, ScalarLane b) { return cond?a:b; }
+inline ScalarLane mul_add(ScalarLane a, ScalarLane b, ScalarLane c) { return a*b+c; }
