+++ b/src/algorithms/regularized_dipole.h
@@ -0,0 +1,48 @@
+#ifndef COFFEE_REGULARIZED_DIPOLE_H
+#define COFFEE_REGULARIZED_DIPOLE_H
+#include "data/grid.h"
+#include "sim_params.h"
+#include <cmath>
+namespace Coffee {
+// A=(mu cross r) f(r), f=r^-3 outside Rstar. Inside, the degree-four
+// Taylor polynomial of u^-3/2 at u=1 gives a finite C4 continuation.
+// Thus all source currents are confined inside the stated stellar radius.
+inline Scalar regularized_dipole_A(Scalar x, Scalar y, Scalar z, int c,
+                                  const sim_params &p) {
+  const Scalar r2=x*x+y*y+z*z, R=p.radius;
+  Scalar f;
+  if(r2>=R*R) f=1.0/(r2*std::sqrt(r2));
+  else {
+    const Scalar u=r2/(R*R)-1.0;
+    f=(1.0+u*(-1.5+u*(1.875+u*(-2.1875+u*2.4609375))))/(R*R*R);
+  }
+  const Scalar cross[3]={p.p2*z-p.p3*y,p.p3*x-p.p1*z,p.p1*y-p.p2*x};
+  return p.b0*cross[c]*f;
+}
+inline Scalar regularized_dipole_derivative(Scalar x,Scalar y,Scalar z,
+    int c,int axis,const sim_params &p,const Grid &g) {
+  Scalar v=0,xyz[3]={x,y,z};
+  const int offsets[4]={-2,-1,1,2};
+  const Scalar weights[4]={1,-8,8,-1};
+  for(int q=0;q<4;++q) {
+    const Scalar orig=xyz[axis]; xyz[axis]+=offsets[q]*g.delta[axis];
+    v+=weights[q]*regularized_dipole_A(xyz[0],xyz[1],xyz[2],c,p);
+    xyz[axis]=orig;
+  }
+  return v*g.inv_delta[axis]/12.0;
+}
+inline Scalar regularized_dipole_B(Scalar x,Scalar y,Scalar z,int c,
+                                  const sim_params &p,const Grid &g) {
+  const int j=(c+1)%3,k=(c+2)%3;
+  return regularized_dipole_derivative(x,y,z,k,j,p,g)-
+         regularized_dipole_derivative(x,y,z,j,k,p,g);
+}
+inline Scalar conductor_weight(Scalar r,Scalar R,Scalar h) {
+  // Compact C2 transition, width two cells, centered on the nominal surface.
+  if(r<=R-h) return 1.0;
+  if(r>=R+h) return 0.0;
+  const Scalar u=(r-R+h)/(2*h);
+  return 1-u*u*u*(10+u*(-15+6*u));
+}
+}
+#endif
